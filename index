                { id: 14, answer: "พระเทวทัต" },
                { id: 15, answer: "ลงพระโลหิต" },
                { id: 16, answer: "สาลวโนทยาน" },
                { id: 17, answer: "ต้นรัง" },
                { id: 18, answer: "สุภัททปริพลาชก" },
                { id: 19, answer: "ถวายเพลิงพระพุทธสรีระ" }
            ],
            distractors: [
                "พระมหากัสสปะ", "โสฬสปัญหา", "วัดเชตวันมหาวิหาร", "พระอานนท์", 
                "แคว้นมคธ", "นางสุชาดา", "การสังคายนา", "พระเจ้าพิมพิสาร", 
                "ธัมมจักกัปปวัตตนสูตร", "นิพพานสุข"
            ]
        };

        let currentUser = { fullName: "", classroom: "", studentNo: "" };
        let timerInterval = null;
        let secondsElapsed = 0;
        let userAnswers = {}; // blankId -> word string
        let shuffledWordBank = [];
        let selectedWordFromBank = null; // สำหรับโหมดแตะเลือกจาก Word Bank

        function handleStartGame(e) {
            e.preventDefault();
            const fullName = document.getElementById('inputFullName').value.trim();
            const classroom = document.getElementById('inputClassroom').value.trim();
            const studentNo = document.getElementById('inputStudentNo').value.trim();

            if (!fullName || !classroom || !studentNo) return;

            currentUser = { fullName, classroom, studentNo };
            document.getElementById('hudUserDisplay').innerText = `${fullName} (${classroom} เลขที่ ${studentNo})`;

            switchView('viewGame');
            initGameSession();
        }

        function switchView(viewId) {
            ['viewHome', 'viewGame', 'viewResult', 'viewLeaderboard'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(viewId).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function initGameSession() {
            userAnswers = {};
            selectedWordFromBank = null;
            secondsElapsed = 0;
            if (timerInterval) clearInterval(timerInterval);
            
            timerInterval = setInterval(() => {
                secondsElapsed++;
                const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                const secs = String(secondsElapsed % 60).padStart(2, '0');
                document.getElementById('timerDisplay').innerText = `${mins}:${secs}`;
            }, 1000);

            // สร้าง Word Bank (20 คำตอบ + 10 ตัวลวง = 30 คำ) สุ่มตำแหน่ง
            const allWords = [
                ...buddhaStoryData.blanks.map(b => b.answer),
                ...buddhaStoryData.distractors
            ];
            shuffledWordBank = shuffleArray([...allWords]);

            renderStory();
            renderWordBank();
            updateProgress();
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        function renderStory() {
            const container = document.getElementById('storyContainer');
            let html = '';

            buddhaStoryData.parts.forEach((part, partIdx) => {
                let formattedPart = part;
                // แทนที่ {BLANK_x} ด้วย Drop Zone / Input Box
                for (let i = 0; i < buddhaStoryData.blanks.length; i++) {
                    const tag = `{BLANK_${i}}`;
                    if (formattedPart.includes(tag)) {
                        const currentVal = userAnswers[i] || "";
                        const zoneHtml = `<span class="inline-block mx-1 my-1 align-middle">
                            <span id="dropzone-${i}" 
                                ondragover="allowDrop(event)" 
                                ondragleave="dragLeave(event)"
                                ondrop="dropWord(event, ${i})" 
                                onclick="clickDropZone(${i})"
                                class="inline-flex items-center justify-center px-3 py-1.5 min-w-[110px] min-h-[36px] bg-slate-100 hover:bg-slate-200 border-2 border-dashed border-purple-300 rounded-xl text-sm font-semibold text-purple-900 cursor-pointer transition shadow-inner">
                                ${currentVal ? currentVal : '<span class="text-slate-400 font-normal text-xs">[ช่องที่ ' + (i+1) + ']</span>'}
                            </span>
                        </span>`;
                        formattedPart = formattedPart.replace(tag, zoneHtml);
                    }
                }
                html += `<p class="mb-4">${formattedPart}</p>`;
            });

            container.innerHTML = html;
        }

        function renderWordBank() {
            const container = document.getElementById('wordBankContainer');
            let html = '';

            shuffledWordBank.forEach((word, idx) => {
                // เช็คว่าคำนี้ถูกใช้ไปหรือยัง
                const isUsed = Object.values(userAnswers).includes(word);
                if (isUsed) {
                    html += `<span class="px-3 py-1.5 bg-slate-200/60 text-slate-400 text-xs font-medium rounded-xl border border-slate-200 select-none line-through">${word}</span>`;
                } else {
                    const isSelected = selectedWordFromBank === word;
                    const selectClass = isSelected ? 'bg-purple-600 text-white ring-4 ring-purple-300 scale-105' : 'bg-white hover:bg-purple-50 text-purple-700 border border-purple-200 shadow-sm';
                    html += `<span draggable="true" 
                        ondragstart="dragStart(event, '${word}')" 
                        onclick="selectWordFromBank('${word}')"
                        class="px-3.5 py-1.5 ${selectClass} text-xs font-semibold rounded-xl cursor-pointer transition inline-block select-none transform active:scale-95">
                        ${word}
                    </span>`;
                }
            });

            container.innerHTML = html;
            document.getElementById('wordBankCount').innerText = `${shuffledWordBank.filter(w => !Object.values(userAnswers).includes(w)).length} / ${shuffledWordBank.length} คำ`;
        }

        // Drag and Drop Handlers
        function dragStart(ev, word) {
            ev.dataTransfer.setData("text/plain", word);
        }

        function allowDrop(ev) {
            ev.preventDefault();
            ev.currentTarget.classList.add('bg-purple-100', 'border-purple-500');
        }

        function dragLeave(ev) {
            ev.currentTarget.classList.remove('bg-purple-100', 'border-purple-500');
        }

        function dropWord(ev, blankId) {
            ev.preventDefault();
            const word = ev.dataTransfer.getData("text/plain");
            if (word) {
                assignWordToBlank(blankId, word);
            }
        }

        // Tap Selection Handlers (สำหรับมือถือ)
        function selectWordFromBank(word) {
            playSound('pop');
            if (selectedWordFromBank === word) {
                selectedWordFromBank = null;
            } else {
                selectedWordFromBank = word;
            }
            renderWordBank();
        }

        function clickDropZone(blankId) {
            playSound('pop');
            if (selectedWordFromBank) {
                // เติมคำที่เลือกไว้ลงช่อง
                assignWordToBlank(blankId, selectedWordFromBank);
                selectedWordFromBank = null;
            } else if (userAnswers[blankId]) {
                // ถ้ามีคำอยู่แล้ว ให้เอาออกคืน Word Bank
                delete userAnswers[blankId];
                renderStory();
                renderWordBank();
                updateProgress();
            }
        }

        function assignWordToBlank(blankId, word) {
            // ถ้าคำนี้เคยถูกเติมในช่องอื่น ให้ลบออกจากช่องเดิมก่อน
            for (let id in userAnswers) {
                if (userAnswers[id] === word) {
                    delete userAnswers[id];
                }
            }
            userAnswers[blankId] = word;
            playSound('pop');
            renderStory();
            renderWordBank();
            updateProgress();
        }

        function updateProgress() {
            const filledCount = Object.keys(userAnswers).length;
            document.getElementById('progressDisplay').innerText = `${filledCount}/20`;
        }

        function resetGameAnswers() {
            userAnswers = {};
            selectedWordFromBank = null;
            renderStory();
            renderWordBank();
            updateProgress();
            playSound('pop');
        }

        function submitGameAnswers() {
            const filledCount = Object.keys(userAnswers).length;
            if (filledCount < 20) {
                showToastMessage("กรุณาเติมคำให้ครบทุกช่องก่อนส่งคำตอบครับ", "error");
                return;
            }

            if (timerInterval) clearInterval(timerInterval);

            // ตรวจคำตอบ
            let score = 0;
            buddhaStoryData.blanks.forEach(b => {
                const userAns = (userAnswers[b.id] || "").trim();
                const dropZoneElem = document.getElementById(`dropzone-${b.id}`);
                if (userAns === b.answer) {
                    score++;
                    if (dropZoneElem) {
                        dropZoneElem.className = "inline-flex items-center justify-center px-3 py-1.5 min-w-[110px] min-h-[36px] bg-emerald-100 border-2 border-emerald-500 rounded-xl text-sm font-bold text-emerald-800 shadow-sm";
                    }
                } else {
                    if (dropZoneElem) {
                        dropZoneElem.className = "inline-flex items-center justify-center px-3 py-1.5 min-w-[110px] min-h-[36px] bg-rose-100 border-2 border-rose-500 rounded-xl text-sm font-bold text-rose-800 shadow-sm";
                    }
                }
            });

            const timeSpent = secondsElapsed;
            const mins = String(Math.floor(timeSpent / 60)).padStart(2, '0');
            const secs = String(timeSpent % 60).padStart(2, '0');

            // บันทึกคะแนนผ่าน google.script.run
            saveScoreToBackend(score, timeSpent);

            // แสดงหน้าผลลัพธ์
            setTimeout(() => {
                document.getElementById('finalScore').innerText = score;
                document.getElementById('finalTime').innerText = `${mins}:${secs}`;
                
                if (score >= 18) {
                    document.getElementById('resultEmoji').innerText = "🌟";
                    document.getElementById('resultTitle').innerText = "สุดยอดนักเรียนดีเด่น!";
                    document.getElementById('resultSubtitle').innerText = "มีความรู้เรื่องพุทธประวัติยอดเยี่ยมมากครับ";
                    confetti({ particleCount: 120, spread: 70, origin: { y: 0.6 } });
                    playSound('success');
                } else if (score >= 12) {
                    document.getElementById('resultEmoji').innerText = "🎉";
                    document.getElementById('resultTitle').innerText = "ทำได้ดีมาก!";
                    document.getElementById('resultSubtitle').innerText = "ผ่านเกณฑ์ความรู้พุทธประวัติแล้วครับ";
                    playSound('success');
                } else {
                    document.getElementById('resultEmoji').innerText = "💪";
                    document.getElementById('resultTitle').innerText = "พยายามอีกนิดนะ!";
                    document.getElementById('resultSubtitle').innerText = "ลองทบทวนเนื้อหาพุทธประวัติแล้วเล่นใหม่อีกครั้งได้เลย";
                    playSound('error');
                }

                switchView('viewResult');
            }, 800);
        }

        function saveScoreToBackend(score, timeSpent) {
            const payload = {
                fullName: currentUser.fullName,
                classroom: currentUser.classroom,
                studentNo: String(currentUser.studentNo),
                score: score,
                timeSpent: timeSpent
            };

            // 1. ถ้ารันอยู่บน Google Apps Script โดยตรง ใช้ google.script.run
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(res => {
                        if (!res.success) {
                            console.error("Save score error:", res.message);
                        }
                    })
                    .withFailureHandler(err => {
                        console.error("Save score failure:", err);
                    })
                    .saveScore(payload);
            } 
            // 2. ถ้ารันไฟล์ HTML จากภายนอก ใช้ Fetch API ยิงไปที่ CONFIG.webAppUrl
            else if (CONFIG.webAppUrl) {
                fetch(CONFIG.webAppUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({ action: 'saveScore', data: payload })
                })
                .then(res => res.json())
                .then(res => {
                    if (!res.success) console.error("Save score error:", res.message);
                })
                .catch(err => console.error("Fetch save score error:", err));
            }
        }

        function retryGame() {
            switchView('viewGame');
            initGameSession();
        }

        function goHome() {
            switchView('viewHome');
        }

        function showLeaderboard() {
            switchView('viewLeaderboard');
            fetchLeaderboardData();
        }

        function fetchLeaderboardData() {
            document.getElementById('leaderboardLoading').classList.remove('hidden');
            document.getElementById('leaderboardContent').classList.add('hidden');

            // 1. ถ้ารันอยู่บน Google Apps Script โดยตรง ใช้ google.script.run
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(data => {
                        renderLeaderboardTable(data);
                    })
                    .withFailureHandler(err => {
                        document.getElementById('leaderboardLoading').innerHTML = `<p class="text-rose-500 text-sm">ไม่สามารถโหลดข้อมูลได้ กรุณาลองใหม่อีกครั้ง</p>`;
                    })
                    .getLeaderboard();
            } 
            // 2. ถ้ารันไฟล์ HTML จากภายนอก ใช้ Fetch API ดึงจาก CONFIG.webAppUrl
            else if (CONFIG.webAppUrl) {
                fetch(`${CONFIG.webAppUrl}?action=getLeaderboard`)
                    .then(res => res.json())
                    .then(data => {
                        renderLeaderboardTable(data);
                    })
                    .catch(err => {
                        console.error("Fetch leaderboard error:", err);
                        document.getElementById('leaderboardLoading').innerHTML = `<p class="text-rose-500 text-sm">ไม่สามารถโหลดข้อมูลได้ กรุณาตรวจสอบการตั้งค่า Deploy</p>`;
                    });
            }
        }

        function renderLeaderboardTable(data) {
            const tbody = document.getElementById('leaderboardTableBody');
            tbody.innerHTML = '';

            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">ยังไม่มีประวัติการทำคะแนน</td></tr>`;
            } else {
                data.forEach((row, index) => {
                    const rank = index + 1;
                    let rankBadge = `<span class="font-semibold text-slate-600">#${rank}</span>`;
                    if (rank === 1) rankBadge = `<span class="bg-amber-400 text-white font-bold px-2 py-0.5 rounded-lg text-xs shadow-sm">🥇 1</span>`;
                    else if (rank === 2) rankBadge = `<span class="bg-slate-300 text-slate-800 font-bold px-2 py-0.5 rounded-lg text-xs shadow-sm">🥈 2</span>`;
                    else if (rank === 3) rankBadge = `<span class="bg-amber-700 text-white font-bold px-2 py-0.5 rounded-lg text-xs shadow-sm">🥉 3</span>`;

                    // ไฮไลต์แถวของผู้เล่นปัจจุบัน
                    const isCurrent = currentUser.fullName && row.fullName === currentUser.fullName && row.classroom === currentUser.classroom;
                    const rowBg = isCurrent ? 'bg-purple-50 font-bold border-l-4 border-purple-600' : (index % 2 === 0 ? 'bg-white' : 'bg-slate-50/50');

                    const mins = String(Math.floor(row.timeSpent / 60)).padStart(2, '0');
                    const secs = String(row.timeSpent % 60).padStart(2, '0');

                    const tr = document.createElement('tr');
                    tr.className = `${rowBg} transition`;
                    tr.innerHTML = `
                        <td class="p-3">${rankBadge}</td>
                        <td class="p-3 text-slate-900">${row.fullName}</td>
                        <td class="p-3 text-slate-600">${row.classroom} (ล. ${row.studentNo})</td>
                        <td class="p-3 text-center font-bold text-purple-700">${row.score}/20</td>
                        <td class="p-3 text-right font-mono text-slate-600 text-xs">${mins}:${secs}</td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            document.getElementById('leaderboardLoading').classList.add('hidden');
            document.getElementById('leaderboardContent').classList.remove('hidden');
        }

        function showToastMessage(msg, type) {
            const overlay = document.getElementById('loadingOverlay');
            document.getElementById('loadingTitle').innerText = type === 'error' ? "แจ้งเตือน" : "สำเร็จ";
            document.getElementById('loadingSubtitle').innerText = msg;
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');

            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 2000);
        }
    </script>
</body>
</html>
